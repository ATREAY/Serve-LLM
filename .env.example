# Copy to .env and adjust. All prefixed SERVELLM_ per backend/core/config.py.

# Any open-weight HF model id or local path — never a paid API model name.
SERVELLM_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
SERVELLM_SERVED_MODEL_ID=default
# "auto" picks the model's declared dtype (often bfloat16), which vLLM's
# AsyncLLMEngine hard-rejects on GPUs below compute capability 8.0 (Ampere).
# This cluster's working serving target is a V100 (compute 7.0) — set
# float16 explicitly. Switch back to "auto" (or "bfloat16") on an A100+.
SERVELLM_DTYPE=float16
SERVELLM_GPU_MEMORY_UTILIZATION=0.85
SERVELLM_TENSOR_PARALLEL_SIZE=1
SERVELLM_ENABLE_LORA=false

SERVELLM_HOST=0.0.0.0
# 8000 is commonly already taken by someone else's process on these shared
# multi-tenant nodes (confirmed on dgx-v100-01) — pick a less common port,
# or check first with `ss -tln | grep :<port>` on the target node.
SERVELLM_PORT=18742

# Comma-separated bearer tokens. Leave empty to disable auth (Phase 1 default).
SERVELLM_API_KEYS=

# SQLite by default — Phase 4's dynamic adapter registry needs zero extra
# infra on the GPU compute node. Point at Postgres for the docker-compose
# deployment instead:
# SERVELLM_DATABASE_URL=postgresql://servellm:servellm@localhost:5432/servellm
SERVELLM_DATABASE_URL=sqlite:///./servellm.db

# Unused until Phase 6 (queueing).
SERVELLM_REDIS_URL=redis://localhost:6379/0

# Phase 4: how long an unused dynamic adapter stays in the in-memory cache
# before the background sweep evicts it (doesn't force vLLM's own GPU-side
# cache to evict — see backend/lora/dynamic.py).
SERVELLM_ADAPTER_IDLE_TTL_SECONDS=600
SERVELLM_ADAPTER_SWEEP_INTERVAL_SECONDS=60

# Phase 13: JWTs issued from a valid API key via POST /v1/admin/auth/token
# (only meaningful once SERVELLM_API_KEYS above is set — with auth disabled
# there's nothing to trade for a token). Dev default below is fine as
# shipped (this server is only ever reached via SSH tunnel or from other
# jobs on this private cluster subnet) — set your own before that changes.
SERVELLM_JWT_SECRET=servellm-dev-secret-change-me-before-any-real-use
SERVELLM_JWT_ALGORITHM=HS256
SERVELLM_JWT_EXPIRY_SECONDS=3600

# Phase 13: sliding-window rate limit per client (API key/JWT if present,
# else IP), applied to /v1/chat/completions and /v1/completions. Set
# SERVELLM_RATE_LIMIT_REQUESTS=0 to disable.
SERVELLM_RATE_LIMIT_REQUESTS=60
SERVELLM_RATE_LIMIT_WINDOW_SECONDS=60
